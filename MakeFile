.PHONY: init infra-up infra-down validate fmt deploy-apps help

help:
	@echo "Available commands:"
	@echo "  make init         - Initialize Terraform"
	@echo "  make validate     - Format and validate Terraform code"
	@echo "  make infra-up     - Provision AWS Infrastructure via Terraform"
	@echo "  make infra-down   - Destroy AWS Infrastructure"
	@echo "  make deploy-apps  - Deploy ArgoCD Root App (App-of-Apps)"

init:
	cd terraform && terraform init

validate:
	cd terraform && terraform fmt -check && terraform validate

infra-up:
	cd terraform && terraform apply -auto-approve

infra-down:
	cd terraform && terraform destroy -auto-approve

deploy-apps:
	kubectl apply -f argocd/root-app.yaml